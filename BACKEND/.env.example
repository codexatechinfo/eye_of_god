# Conexão com o Postgres local (self-hosted via Supabase, WSL) — role app_user,
# sem privilégio de DDL. Ver docs/adr/0002-postgres-local-via-supabase-sem-prisma.md
DATABASE_URL="postgresql://app_user:senha@localhost:55432/postgres"

# UUID da empresa (tabela empresas) dona da conta Copel usada pelo scraper —
# os jobs rodam fora de request HTTP, sem token, e usam essa empresa como
# identidade fixa. Ver docs/adr/0003-rbac-multi-tenant.md
EMPRESA_PRINCIPAL_ID=

# Porta do servidor Express (opcional, padrão 3000)
PORT=3000

# Segredo usado para assinar/validar o JWT de autenticação — gerar com
# `openssl rand -base64 48`, nunca reaproveitar entre ambientes
JWT_SECRET=

# Credenciais do portal COPEL — usadas por Massivas, pela extração de
# Controle de Empreiteiras e pelo scraper de Acompanhamento (mesma conta
# pros três, ver copelSessaoLock.js pra evitar login de um derrubar a
# sessão do outro).
COPEL_USERNAME=
COPEL_PASSWORD=

# "true" abre o Chromium do scraper com janela visível (útil pra debugar ao
# vivo o que o site está fazendo) — default é headless (sem janela), o
# comportamento certo pra produção já que o job roda sozinho o dia inteiro.
COPEL_HEADLESS=true

# Teto de duração (minutos) só do MODO PROFUNDO do scraper de Acompanhamento
# — a 1ª extração bem-sucedida de cada dia, que abre a OS de cada livro pra
# aprender de verdade quais UCs cada um tem (ver
# rosterUcsAcompanhamentoService.js). O modo rápido de todo ciclo normal
# nunca usa isso, sempre termina em segundos. Opcional — default 90min.
# 0 (ou negativo) desliga o teto por completo — roda até esgotar a fila.
COPEL_TIMEOUT_PROFUNDO_MIN=90

# Quantas abas em paralelo o MODO PROFUNDO abre pra abrir a OS de cada
# livro mais rápido (mesma sessão/cookies, só client-side em paralelo).
# Opcional — default 5 (valor empírico da ADR 0020 histórica: 8 sobrecarregava
# mais o portal, 5 deu o melhor equilíbrio real).
COPEL_PARALELISMO_ACOMP=5

# Concessionária/empreiteira usadas pra filtrar o relatório "Controle de
# Empreiteiras" (-> base_dados_leitura), extraído dentro do job de Massivas
# (mesma sessão Copel, ver copelMassivasScraperService.js). Opcionais — sem
# definir, usa os mesmos defaults do script original do usuário.
COPEL_CONCESSIONARIA=COMPANHIA PARANAENSE DE ENERGIA
COPEL_EMPREITEIRA=F IMM BRASIL LTDA

# Token da API Frota Remote (SEGSAT) — header "frota-token" do endpoint de
# login, retorna um "sid" de sessão (expira em 3min sem uso). Usado pra
# posicionar em tempo real os colaboradores motoqueiros.
SEGSAT_FROTA_TOKEN=

# API Scalefusion (via FIMM) — posição, bateria e nome (com colaborador
# embutido) dos aparelhos em campo. Token bearer sem expiração, sem fluxo de
# login (diferente do SEGSAT_FROTA_TOKEN acima).
SCALEFUSION_API_BASE=http://apisf.webfimm.com.br:4000
SCALEFUSION_API_TOKEN=

# Nomes das tabelas de staging usadas pelos jobs de coleta
DB_TABLE_PENDENTES=pendentes_im
DB_TABLE_ATRIBUIDAS=atribuidas_im
DB_TABLE_EM_EXECUCAO=em_execucao_im
DB_TABLE_MASSIVAS=massivas
